NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Powers distributed (real, cross-instance) API rate limiting via
# Upstash Redis — add the free "Upstash" integration from the Vercel
# Marketplace (Project → Storage → Marketplace Database Providers → Upstash)
# and it fills these in for you automatically (as KV_REST_API_URL/TOKEN —
# lib/rateLimit.ts also accepts UPSTASH_REDIS_REST_URL/TOKEN if you provision
# a database directly on upstash.com instead). Without them, rate limiting
# still works but only per-instance (see lib/rateLimit.ts).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Server-only — never expose to the browser. Used by lib/yahooAuth.ts and the
# /api/cron/* routes to bypass RLS as the service role.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Enables AI narrative/portfolio generation in
# lib/companyNarrative.ts and /api/portfolio-research; those routes fall back
# to non-AI behavior when this is unset.
ANTHROPIC_API_KEY=

# Server-only shared secret checked by /api/cron/* routes (see
# .github/workflows/*.yml, which must be configured with the same value as a
# GitHub Actions repository secret).
CRON_SECRET=

# Optional but recommended in production. The canonical public origin of this
# deployment, e.g. https://strategylabai.net. Password-reset links are built
# from this instead of from the incoming request's Host header, so a link can
# never be issued pointing at a preview deployment. Falls back to the request
# origin when unset.
NEXT_PUBLIC_SITE_URL=

# Optional. Deployment-wide daily ceiling on calls to the paid AI routes
# (/api/company-report/narrative and /api/portfolio-research), on top of the
# per-IP and per-account limits. Accounts are free and self-serve, so the
# per-account caps bound one account, not the bill — this is the number that
# bounds what a single bad day can cost. Defaults to 500/day when unset.
AI_GLOBAL_DAILY_LIMIT=
