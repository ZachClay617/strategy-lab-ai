NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Powers distributed (real, cross-instance) API rate limiting via
# Upstash Redis — add the free "Upstash" integration from the Vercel
# Marketplace (Project → Storage → Marketplace Database Providers → Upstash)
# and it fills these in for you automatically (as KV_REST_API_URL/TOKEN —
# lib/rateLimit.ts also accepts UPSTASH_REDIS_REST_URL/TOKEN if you provision
# a database directly on upstash.com instead). Without them, rate limiting
# still works but only per-instance (see lib/rateLimit.ts).
KV_REST_API_URL=
KV_REST_API_TOKEN=
