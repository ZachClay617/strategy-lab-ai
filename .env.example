NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Powers distributed (real, cross-instance) API rate limiting via
# Upstash Redis — add the free "Upstash" integration from the Vercel
# Marketplace (Project → Storage → Marketplace Database Providers → Upstash)
# and it fills these in for you automatically. Without them, rate limiting
# still works but only per-instance (see lib/rateLimit.ts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
